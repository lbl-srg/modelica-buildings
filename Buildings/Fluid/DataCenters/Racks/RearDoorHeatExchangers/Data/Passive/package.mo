within Buildings.Fluid.DataCenters.Racks.RearDoorHeatExchangers.Data;
package Passive "Data records for passive rear door heat exchangers"
  extends Modelica.Icons.MaterialPropertiesPackage;
annotation (preferredView="info", Documentation(info="<html>
<p>
This package contains data records for passive rear door heat exchangers.
In a passive rear door heat exchanger, the server fans inside the rack
drive airflow through the heat exchanger.
</p>
</html>"));
end Passive;
