within Buildings.Fluid.DataCenters.Racks.RearDoorHeatExchangers.Data;
package Active "Data records for active rear door heat exchangers"
  extends Modelica.Icons.MaterialPropertiesPackage;
annotation (preferredView="info", Documentation(info="<html>
<p>
This package contains data records for active rear door heat exchangers.
In an active rear door heat exchanger, an integrated fan drives airflow
through the heat exchanger independently of the server fans inside the rack.
</p>
</html>"));
end Active;
