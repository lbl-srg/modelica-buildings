within Buildings.Fluid.DataCenters.CDUs.LiquidToLiquid.Examples;
model CDU_epsNTU_externalControl
  "Example model of a CDU for which the pump speed and the valve position are provided by an external controller"
  extends Buildings.Fluid.DataCenters.CDUs.LiquidToLiquid.Examples.CDU_epsNTU(
    cdu(
      use_yPum_in=true,
      use_yVal_in=true),
    break connect(dpSet.y, cdu.dpSet),
    break connect(TSetRacIn.y, cdu.TSet));

  Buildings.Controls.OBC.CDL.Reals.Sources.Pulse yPum(
    amplitude=-0.2,
    width=0.5,
    period=3600,
    shift=1800,
    offset=1)
    "Pump speed command, reduced by 20 percent for half of each hour after the first 30 minutes"
    annotation (Placement(transformation(extent={{-60,-100},{-40,-80}})));
  Buildings.Controls.OBC.CDL.Reals.PID conVal(
    u_s(final unit="K", displayUnit="degC"),
    u_m(final unit="K", displayUnit="degC"),
    controllerType=Buildings.Controls.OBC.CDL.Types.SimpleController.PI,
    k=1,
    Ti=120,
    reverseActing=false,
    r=10,
    xi_start=1)
    "External controller that tracks the rack supply temperature by commanding the valve"
    annotation (Placement(transformation(extent={{-90,72},{-70,92}})));
equation
  connect(yPum.y, cdu.yPum_in)
    annotation (Line(points={{-38,-90},{-30,-90},{-30,12},{-12,12}}, color={0,0,127}));
  connect(TSetRacIn.y, conVal.u_s)
    annotation (Line(points={{-38,82},{-92,82}}, color={0,0,127}));
  connect(senTRac_a.T, conVal.u_m)
    annotation (Line(points={{-80,31},{-80,70}}, color={0,0,127}));
  connect(conVal.y, cdu.yVal_in)
    annotation (Line(points={{-68,82},{-20,82},{-20,30},{-12,30}}, color={0,0,127}));
  annotation (
    experiment(
      StopTime=7200,
      Tolerance=1e-06),
    __Dymola_Commands(
      file="modelica://Buildings/Resources/Scripts/Dymola/Fluid/DataCenters/CDUs/LiquidToLiquid/Examples/CDU_epsNTU_externalControl.mos"
      "Simulate and plot"),
    Documentation(info="<html>
<p>
Example model of a CDU that serves liquid cooled racks, as in
<a href=\"modelica://Buildings.Fluid.DataCenters.CDUs.LiquidToLiquid.Examples.CDU_epsNTU\">
Buildings.Fluid.DataCenters.CDUs.LiquidToLiquid.Examples.CDU_epsNTU</a>,
but with the controllers inside the CDU replaced by signals from outside the CDU.
</p>
<p>
The parameters <code>use_yPum_in</code> and <code>use_yVal_in</code> of the CDU are
set to <code>true</code>.
Therefore, the CDU has no internal controller for the pump and the valve, and its inputs
<code>dpSet</code> and <code>TSet</code> do not exist.
Instead, the pump speed is set through the input <code>yPum_in</code> and the valve position
is set through the input <code>yVal_in</code>.
</p>
<p>
The valve position is computed by the PI controller <code>conVal</code>, which tracks the
temperature of the coolant that is sent to the IT rack.
The pump speed is a pulse signal that reduces the speed by <i>20</i> percent
for half of each hour, starting after the first <i>30</i> minutes.
This can be used, for example, to
operate the pumps of several CDUs with a common controller.
</p>
<p>
Reference results for this model are generated by the maintainers of the library.
</p>
</html>", revisions="<html>
<ul>
<li>
November 18, 2026, by Nauman Rafique:<br/>
First implementation.
This is for <a href=\"https://github.com/lbl-srg/modelica-buildings/issues/4905\">Buildings, #4905</a>.
</li>
</ul>
</html>"));
end CDU_epsNTU_externalControl;
