simulateModel("Buildings.Fluid.Geothermal.Borefields.BaseClasses.Boreholes.BaseClasses.Functions.Validation.FluidProperties_T", stopTime=3600, method="CVode", tolerance=1E-6, resultFile="FluidProperties_T");

