simulateModel("Buildings.Fluid.Geothermal.Borefields.Examples.BorefieldsTDepRconv", startTime=0, stopTime=36000, method="CVode", tolerance=1E-6, resultFile="BorefieldsTDepRconv");

createPlot(
  id=1,
  position={0, 0, 1268, 736},
  x="time",
  y={"TOutFixWat.T", "TOutWat.T", "TOutFixGly.T", "TOutGly.T"},
  autoscale=true,
  autoerase=true,
  autoreplot=true,
  grid=true,
  colors={{0,0,0}, {28,108,200}, {160,160,160}, {238,46,47}},
  filename="BorefieldsTDepRconv.mat",
  leftTitleType=1,
  bottomTitleType=1);

