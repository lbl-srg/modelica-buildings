simulateModel("Buildings.Fluid.Storage.Validation.ExpansionVesselMassConservation", tolerance=1e-6, stopTime=7200, method="CVode", resultFile="ExpansionVesselMassConservation");
createPlot(id=1,
 position={15, 10, 650, 700},
 y={"vol.T", "expVes1.T", "expVes2.T"},
 range={0.0, 7200.0, 15.0, 65.0},
 subPlot=101,
 grid=true,
 autoscale=true,
 autoerase=true,
 autoreplot=true,
 color=true,
 timeUnit="s",
 displayUnits={"degC", "degC", "degC"});
createPlot(id=1,
 position={15, 10, 650, 700},
 y={"expVes1.port_a.p", "expVes2.port_a.p", "vol.p"},
 range={0.0, 7200.0, 1.8e5, 3.6e5},
 subPlot=102,
 grid=true,
 autoscale=true,
 autoerase=true,
 autoreplot=true,
 color=true,
 timeUnit="s",
 displayUnits={"Pa", "Pa", "Pa"});
createPlot(id=1,
 position={15, 10, 650, 700},
